  "item": [
    {
      "name": "Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const token = pm.response.json().access_token;\r",
              "pm.collectionVariables.set(\"token\", token);\r",
              "\r",
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));\r",
              "pm.test(\"Token recibido\", () => pm.expect(pm.response.json()).to.have.property(\"access_token\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"admin123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8000/login",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
